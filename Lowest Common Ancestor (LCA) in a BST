# Python program to find the Lowest Common Ancestor (LCA) in a BST
# using properties of BST and an iterative approach

class TreeNode:
    def __init__(self, val):
        self.val = val
        self.left = None
        self.right = None

# Function to find the LCA of nodeA and nodeB in the BST
def findLowestCommonAncestor(root, nodeA, nodeB):
    while root:
        # If both nodes are less than root, move left
        if root.val > nodeA.val and root.val > nodeB.val:
            root = root.left
        # If both nodes are greater than root, move right
        elif root.val < nodeA.val and root.val < nodeB.val:
            root = root.right
        # LCA found
        else:
            break
    return root

if __name__ == "__main__":
    # Constructing this BST:
    #           30
    #         /    \
    #        15     50
    #       /  \   /  \
    #     10   20 40  60

    root = TreeNode(30)
    root.left = TreeNode(15)
    root.right = TreeNode(50)
    root.left.left = TreeNode(10)
    root.left.right = TreeNode(20)
    root.right.left = TreeNode(40)
    root.right.right = TreeNode(60)

    node1 = root.left.left        # Node 10
    node2 = root.left.right       # Node 20

    lca = findLowestCommonAncestor(root, node1, node2)
    print(f"Lowest Common Ancestor of {node1.val} and {node2.val} is: {lca.val}")
